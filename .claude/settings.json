{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(php -v)",
      "Bash(php -m)",
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(composer show:*)",
      "Bash(composer run:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(sqlite3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(diff:*)"
    ],
    "ask": [
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
